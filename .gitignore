/android/app/release

# Flutter/Dart auto-generated files
build/

# IDE files (VS Code, Android Studio)
.vscode/

# --- SENSITIVE KEYS (Most Important) ---

# Firebase config file (Dart)
/lib/firebase_options.dart

# Firebase config file (Android)
/android/app/google-services.json

# Firebase config file (iOS)
/ios/Runner/GoogleService-Info.plist

# Supabase config file (Custom)
/.env

# --- END SENSITIVE KEYS ---

# Android build files & keys
/android/local.properties
/android/.gradle/
/android/app/build/
/android/key.jks
/android/app/src/main/assets/flutter_assets/

# iOS build files
/ios/Pods/
/ios/Podfile.lock
/ios/Runner.xcworkspace/
/ios/Runner.xcodeproj/project.xcworkspace/
/ios/Runner.xcodeproj/xcuserdata/
/ios/Flutter/App.framework
/ios/Flutter/engine.framework
/ios/Flutter/flutter_assets/

