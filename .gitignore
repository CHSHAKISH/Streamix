#          Android
# ============================

android/gradlew
android/gradlew.bat
android/local.properties
android/app/google-services.json        # IMPORTANT: Hide Firebase Config
android/.gradle
android/captures/
android/gradle/
android/**/generated/
android/**/gradle/
android/**/build/

